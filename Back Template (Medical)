<!--
 * ============================================================================
 * ANKI CLOZE-CHATGPT - BACK TEMPLATE
 * ============================================================================
 * 
 * Back template for medical flashcards with expandable resource hints.
 * 
 * FEATURES:
 * - Editable cloze text (works with "Edit Field During Review" addon)
 * - Resource hint buttons (UWorld, AMBOSS, First Aid, etc.)
 * - GPU-accelerated animations for smooth performance
 * - Keyboard shortcuts: H = open next hint, Shift+H = close all
 * - Prevents listener stacking across card reviews
 * 
 * FIELDS:
 * - Text: Main cloze content
 * - Extra: Always-visible notes (optional)
 * - UWorld_3, UWorld_2CK, NEJM, AMBOSS, First_Aid, Kaplan, 
 *   Pathoma, UpToDate, NBME, Notes, Additional_Resources
 * 
 * AUTHOR: Christos Longros
 * LICENSE: BSD 3-Clause
 * ============================================================================
-->

<div class="card-wrapper">

  <!-- QUESTION: Uses edit:cloze for "Edit Field During Review" addon -->
  <div class="question">
    {{edit:cloze:Text}}
  </div>

  <div class="frontBackDivider"></div>

  <!-- HINT BUTTONS: Only appear if field has content -->
  <div id="hintRow">
    {{#UWorld_3}}<span class="pill uworld" data-field="UWorld_3"><a class="hint" href="javascript:void(0)">UWorld_3</a></span>{{/UWorld_3}}
    {{#UWorld_2CK}}<span class="pill uworld2ck" data-field="UWorld_2CK"><a class="hint" href="javascript:void(0)">UWorld_2CK</a></span>{{/UWorld_2CK}}
    {{#NEJM}}<span class="pill nejm" data-field="NEJM"><a class="hint" href="javascript:void(0)">NEJM</a></span>{{/NEJM}}
    {{#AMBOSS}}<span class="pill amboss" data-field="AMBOSS"><a class="hint" href="javascript:void(0)">AMBOSS</a></span>{{/AMBOSS}}
    {{#First_Aid}}<span class="pill fa" data-field="First_Aid"><a class="hint" href="javascript:void(0)">First_Aid</a></span>{{/First_Aid}}
    {{#Kaplan}}<span class="pill kaplan" data-field="Kaplan"><a class="hint" href="javascript:void(0)">Kaplan</a></span>{{/Kaplan}}
    {{#Pathoma}}<span class="pill pathoma" data-field="Pathoma"><a class="hint" href="javascript:void(0)">Pathoma</a></span>{{/Pathoma}}
    {{#UpToDate}}<span class="pill utd" data-field="UpToDate"><a class="hint" href="javascript:void(0)">UpToDate</a></span>{{/UpToDate}}
    {{#NBME}}<span class="pill nbme" data-field="NBME"><a class="hint" href="javascript:void(0)">NBME</a></span>{{/NBME}}
    {{#Notes}}<span class="pill notes" data-field="Notes"><a class="hint" href="javascript:void(0)">Notes</a></span>{{/Notes}}
    {{#Additional_Resources}}<span class="pill add" data-field="Additional_Resources"><a class="hint" href="javascript:void(0)">Additional_Resources</a></span>{{/Additional_Resources}}
  </div>

  <!-- EXTRA: Always visible when populated -->
  {{#Extra}}
  <div class="extra">{{edit:Extra}}</div>
  {{/Extra}}

  <!-- HINT CONTENT AREA: Expanded hints appear here -->
  <div id="hintContentArea"></div>

  <!-- HIDDEN CONTENT STORES: Using divs instead of <template> for AnkiDroid compatibility -->
  {{#UWorld_3}}<div class="hintStore" data-field="UWorld_3">{{UWorld_3}}</div>{{/UWorld_3}}
  {{#UWorld_2CK}}<div class="hintStore" data-field="UWorld_2CK">{{UWorld_2CK}}</div>{{/UWorld_2CK}}
  {{#NEJM}}<div class="hintStore" data-field="NEJM">{{NEJM}}</div>{{/NEJM}}
  {{#AMBOSS}}<div class="hintStore" data-field="AMBOSS">{{AMBOSS}}</div>{{/AMBOSS}}
  {{#First_Aid}}<div class="hintStore" data-field="First_Aid">{{First_Aid}}</div>{{/First_Aid}}
  {{#Kaplan}}<div class="hintStore" data-field="Kaplan">{{Kaplan}}</div>{{/Kaplan}}
  {{#Pathoma}}<div class="hintStore" data-field="Pathoma">{{Pathoma}}</div>{{/Pathoma}}
  {{#UpToDate}}<div class="hintStore" data-field="UpToDate">{{UpToDate}}</div>{{/UpToDate}}
  {{#NBME}}<div class="hintStore" data-field="NBME">{{NBME}}</div>{{/NBME}}
  {{#Notes}}<div class="hintStore" data-field="Notes">{{Notes}}</div>{{/Notes}}
  {{#Additional_Resources}}<div class="hintStore" data-field="Additional_Resources">{{Additional_Resources}}</div>{{/Additional_Resources}}

</div>

<!-- ============================================================================
     JAVASCRIPT - HINT TOGGLE FUNCTIONALITY
     ============================================================================
     
     KEYBOARD SHORTCUTS:
     - H: Open next closed hint (in button order)
     - Shift+H: Close all hints and scroll to top
     - H when all open: Close all and scroll to top
     
     FEATURES:
     - Prevents listener stacking (Anki reuses webview)
     - GPU-accelerated animations via .hintBodyInner
     - Works with "Edit Field During Review" addon
============================================================================ -->
<script>
(function() {
  // ============================================================================
  // ADAPTIVE FONT SIZE
  // ============================================================================
  // Measure text length and apply appropriate size class
  
  var question = document.querySelector(".question");
  if (question) {
    // Get text content without HTML tags
    var text = question.textContent || question.innerText || "";
    var len = text.replace(/\s+/g, " ").trim().length;
    
    // Remove any existing size classes
    question.classList.remove("text-short", "text-medium", "text-long");
    
    // Apply class based on length thresholds
    if (len < 80) {
      question.classList.add("text-short");
    } else if (len < 200) {
      question.classList.add("text-medium");
    } else {
      question.classList.add("text-long");
    }
  }

  // ============================================================================
  // HINT TOGGLE FUNCTIONALITY
  // ============================================================================
  
  var row = document.getElementById("hintRow");
  var area = document.getElementById("hintContentArea");
  if (!row || !area) return;

  // ============================================================================
  // PREVENT LISTENER STACKING
  // ============================================================================
  // Anki reuses webview across cards - remove old listeners before adding new
  
  try {
    if (window.__CL_HINTS_KEYDOWN__) {
      document.removeEventListener("keydown", window.__CL_HINTS_KEYDOWN__, true);
      window.__CL_HINTS_KEYDOWN__ = null;
    }
    if (window.__CL_HINTS_ROWCLICK__ && window.__CL_HINTS_ROWCLICK_ROW__ === row) {
      row.removeEventListener("click", window.__CL_HINTS_ROWCLICK__, false);
      window.__CL_HINTS_ROWCLICK__ = null;
      window.__CL_HINTS_ROWCLICK_ROW__ = null;
    }
  } catch(e) {}

  // Disable smooth scroll for instant scroll-to-top
  try { document.documentElement.style.scrollBehavior = "auto"; } catch(e) {}

  // ============================================================================
  // POLYFILLS FOR ANKIDROID
  // ============================================================================
  
  if (!Element.prototype.matches) {
    Element.prototype.matches = Element.prototype.msMatchesSelector || Element.prototype.webkitMatchesSelector;
  }
  if (!Element.prototype.closest) {
    Element.prototype.closest = function(s) {
      var el = this;
      while (el && el.nodeType === 1) {
        if (el.matches(s)) return el;
        el = el.parentElement || el.parentNode;
      }
      return null;
    };
  }

  // ============================================================================
  // UTILITY FUNCTIONS
  // ============================================================================

  function focusForHotkeys() {
    try {
      if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
      document.body.tabIndex = -1;
      document.body.focus();
    } catch(e) {}
  }

  function blockId(f) { return "hintBlock__" + f; }
  function isOpen(f) { return !!document.getElementById(blockId(f)); }

  function scrollToTopOf(el, offset) {
    if (!el) return;
    var off = (typeof offset === "number") ? offset : 12;
    el.scrollIntoView(true);
    window.scrollBy(0, -off);
  }

  // ============================================================================
  // COLLECT CONTENT FROM HIDDEN STORES
  // ============================================================================

  var templates = {};
  var stores = document.querySelectorAll(".hintStore[data-field]");
  for (var i = 0; i < stores.length; i++) {
    var f = stores[i].getAttribute("data-field");
    templates[f] = stores[i].innerHTML;
  }

  // ============================================================================
  // ESTABLISH BUTTON ORDER
  // ============================================================================

  var pillOrder = [];
  var allPills = row.querySelectorAll(".pill[data-field]");
  for (var j = 0; j < allPills.length; j++) {
    pillOrder.push(allPills[j].getAttribute("data-field"));
  }

  function getInsertPosition(field) {
    var fieldIndex = pillOrder.indexOf(field);
    var existingBlocks = area.querySelectorAll(".hintBlock");
    for (var i = 0; i < existingBlocks.length; i++) {
      var blockField = existingBlocks[i].id.replace("hintBlock__", "");
      var blockIndex = pillOrder.indexOf(blockField);
      if (blockIndex > fieldIndex) return existingBlocks[i];
    }
    return null;
  }

  // ============================================================================
  // OPEN / CLOSE FUNCTIONS
  // ============================================================================

  function openHint(field, btn) {
    if (isOpen(field)) {
      var existing = document.getElementById(blockId(field));
      if (existing) scrollToTopOf(existing, 12);
      if (btn) btn.classList.add("activeHint");
      return;
    }

    if (!templates.hasOwnProperty(field)) return;

    var block = document.createElement("div");
    block.className = "hintBlock";
    block.id = blockId(field);

    var header = document.createElement("div");
    header.className = "hintHeader";
    header.textContent = (btn ? btn.textContent : field).replace(/[+−]/g, "").trim();

    var body = document.createElement("div");
    body.className = "hintBody";

    var inner = document.createElement("div");
    inner.className = "hintBodyInner";
    inner.innerHTML = templates[field];

    body.appendChild(inner);
    block.appendChild(header);
    block.appendChild(body);

    var insertBefore = getInsertPosition(field);
    if (insertBefore) area.insertBefore(block, insertBefore);
    else area.appendChild(block);

    if (btn) btn.classList.add("activeHint");

    block.classList.add("open");
    requestAnimationFrame(function(){ block.classList.add("animateIn"); });

    setTimeout(function(){
      scrollToTopOf(block, 12);
      focusForHotkeys();
    }, 40);
  }

  function closeHint(field, btn) {
    var block = document.getElementById(blockId(field));
    if (!block) {
      if (btn) btn.classList.remove("activeHint");
      return;
    }
    block.classList.remove("animateIn");
    block.classList.add("closing");
    setTimeout(function(){
      if (block.parentNode) block.parentNode.removeChild(block);
    }, 190);
    if (btn) btn.classList.remove("activeHint");
    focusForHotkeys();
  }

  function closeHintInstant(field, btn) {
    var block = document.getElementById(blockId(field));
    if (block && block.parentNode) block.parentNode.removeChild(block);
    if (btn) btn.classList.remove("activeHint");
  }

  function closeAllInstantAndTop() {
    var pills = row.querySelectorAll(".pill[data-field]");
    for (var i = 0; i < pills.length; i++) {
      var field = pills[i].getAttribute("data-field");
      var btn = pills[i].querySelector("a.hint");
      if (field && isOpen(field)) closeHintInstant(field, btn);
    }
    window.scrollTo(0, 0);
    focusForHotkeys();
  }

  function togglePill(pill) {
    var field = pill.getAttribute("data-field");
    if (!field) return;
    var btn = pill.querySelector("a.hint");
    if (isOpen(field)) closeHint(field, btn);
    else openHint(field, btn);
  }

  // ============================================================================
  // EVENT HANDLERS
  // ============================================================================

  var rowClickHandler = function(e){
    var pill = e.target.closest(".pill");
    if (!pill) return;
    e.preventDefault();
    e.stopPropagation();
    togglePill(pill);
    focusForHotkeys();
  };
  row.addEventListener("click", rowClickHandler, false);
  window.__CL_HINTS_ROWCLICK__ = rowClickHandler;
  window.__CL_HINTS_ROWCLICK_ROW__ = row;

  var keyHandler = function(e) {
    // Allow typing in inputs, but work in contenteditable for edit addon
    var t = e.target;
    if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;

    var key = e.key || String.fromCharCode(e.keyCode || e.which);
    if (key !== "h" && key !== "H") return;
    if (e.ctrlKey || e.altKey || e.metaKey) return;

    e.preventDefault();
    e.stopPropagation();

    // Shift+H: close all
    if (e.shiftKey) {
      closeAllInstantAndTop();
      return;
    }

    // Count open/closed
    var openCount = 0, closedCount = 0;
    for (var i = 0; i < pillOrder.length; i++) {
      if (isOpen(pillOrder[i])) openCount++;
      else closedCount++;
    }

    // All open -> close all
    if (openCount > 0 && closedCount === 0) {
      closeAllInstantAndTop();
      return;
    }

    // Open next closed
    var nextClosed = null;
    for (var j = 0; j < pillOrder.length; j++) {
      var f = pillOrder[j];
      if (!isOpen(f)) {
        var pillEl = row.querySelector(".pill[data-field='" + f + "']");
        if (pillEl) { nextClosed = pillEl; break; }
      }
    }

    if (nextClosed) togglePill(nextClosed);
    else closeAllInstantAndTop();
  };

  document.addEventListener("keydown", keyHandler, true);
  window.__CL_HINTS_KEYDOWN__ = keyHandler;

  setTimeout(focusForHotkeys, 100);
})();
</script>
