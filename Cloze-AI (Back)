<!--
================================================================================
CLOZE-AI — BACK TEMPLATE
================================================================================
PURPOSE:
  Displays the answer side of the cloze card with expandable hint buttons
  for various medical resources (UWorld, First Aid, AMBOSS, etc.).
FEATURES:
  - 13 expandable resource hint buttons (Notes, UWorld 3, UWorld 2CK, AMBOSS,
    Missed Questions, Kaplan, Pathoma, Boards and Beyond, First Aid, NBME,
    NEJM, UpToDate, Additional Resources)
  - Keyboard shortcut 'H' to cycle through hints (desktop only)
  - Shift+H to close all hints and scroll to top
  - AnkiDroid gesture-safe (removed stopPropagation blocking swipes)
  - Adaptive font size based on text length
  - Removes <br> tags between consecutive images for consistent spacing
USAGE:
  Copy this entire file content into Anki's "Back Template" field.
AUTHOR: Christos Longros
LICENSE: BSD 3-Clause
================================================================================
-->

<div class="card-wrapper">

  <!-- Question with revealed answer -->
  <div class="question">
    {{edit:cloze:Text}}
  </div>

  <div class="frontBackDivider"></div>

  <!--
  ============================================================================
  HINT BUTTONS ROW
  ============================================================================
  Each button is shown only if the corresponding field has content.
  The data-field attribute links to the hidden content store below.
  ============================================================================
  -->
  <div id="hintRow">
    {{#Notes}}<span class="pill notes" data-field="Notes"><a class="hint" href="#">Notes</a></span>{{/Notes}}
    {{#UWorld_3}}<span class="pill uworld" data-field="UWorld_3"><a class="hint" href="#">UWorld 3</a></span>{{/UWorld_3}}
    {{#UWorld_2CK}}<span class="pill uworld2ck" data-field="UWorld_2CK"><a class="hint" href="#">UWorld 2CK</a></span>{{/UWorld_2CK}}
    {{#AMBOSS}}<span class="pill amboss" data-field="AMBOSS"><a class="hint" href="#">AMBOSS</a></span>{{/AMBOSS}}
    {{#Missed_Questions}}<span class="pill missed" data-field="Missed_Questions"><a class="hint" href="#">Missed Questions</a></span>{{/Missed_Questions}}
    {{#Kaplan}}<span class="pill kaplan" data-field="Kaplan"><a class="hint" href="#">Kaplan</a></span>{{/Kaplan}}
    {{#Pathoma}}<span class="pill pathoma" data-field="Pathoma"><a class="hint" href="#">Pathoma</a></span>{{/Pathoma}}
    {{#Boards_and_Beyond}}<span class="pill bnb" data-field="Boards_and_Beyond"><a class="hint" href="#">Boards and Beyond</a></span>{{/Boards_and_Beyond}}
    {{#First_Aid}}<span class="pill fa" data-field="First_Aid"><a class="hint" href="#">First Aid</a></span>{{/First_Aid}}
    {{#NBME}}<span class="pill nbme" data-field="NBME"><a class="hint" href="#">NBME</a></span>{{/NBME}}
    {{#NEJM}}<span class="pill nejm" data-field="NEJM"><a class="hint" href="#">NEJM</a></span>{{/NEJM}}
    {{#UpToDate}}<span class="pill utd" data-field="UpToDate"><a class="hint" href="#">UpToDate</a></span>{{/UpToDate}}
    {{#Additional_Resources}}<span class="pill add" data-field="Additional_Resources"><a class="hint" href="#">Additional Resources</a></span>{{/Additional_Resources}}
  </div>

  <!-- Extra field (if present) -->
  {{#Extra}}
  <div class="extra">{{edit:Extra}}</div>
  {{/Extra}}

  <!-- Container where expanded hints appear -->
  <div id="hintContentArea"></div>

  <!--
  ============================================================================
  HIDDEN CONTENT STORES
  ============================================================================
  These hidden divs store the actual content for each hint button.
  The JavaScript reads from these when a button is clicked.
  ============================================================================
  -->
  {{#Notes}}<div class="hintStore" data-field="Notes">{{Notes}}</div>{{/Notes}}
  {{#UWorld_3}}<div class="hintStore" data-field="UWorld_3">{{UWorld_3}}</div>{{/UWorld_3}}
  {{#UWorld_2CK}}<div class="hintStore" data-field="UWorld_2CK">{{UWorld_2CK}}</div>{{/UWorld_2CK}}
  {{#AMBOSS}}<div class="hintStore" data-field="AMBOSS">{{AMBOSS}}</div>{{/AMBOSS}}
  {{#Missed_Questions}}<div class="hintStore" data-field="Missed_Questions">{{Missed_Questions}}</div>{{/Missed_Questions}}
  {{#Kaplan}}<div class="hintStore" data-field="Kaplan">{{Kaplan}}</div>{{/Kaplan}}
  {{#Pathoma}}<div class="hintStore" data-field="Pathoma">{{Pathoma}}</div>{{/Pathoma}}
  {{#Boards_and_Beyond}}<div class="hintStore" data-field="Boards_and_Beyond">{{Boards_and_Beyond}}</div>{{/Boards_and_Beyond}}
  {{#First_Aid}}<div class="hintStore" data-field="First_Aid">{{First_Aid}}</div>{{/First_Aid}}
  {{#NBME}}<div class="hintStore" data-field="NBME">{{NBME}}</div>{{/NBME}}
  {{#NEJM}}<div class="hintStore" data-field="NEJM">{{NEJM}}</div>{{/NEJM}}
  {{#UpToDate}}<div class="hintStore" data-field="UpToDate">{{UpToDate}}</div>{{/UpToDate}}
  {{#Additional_Resources}}<div class="hintStore" data-field="Additional_Resources">{{Additional_Resources}}</div>{{/Additional_Resources}}

</div>

<!--
================================================================================
MAIN SCRIPT
================================================================================
SECTIONS:
  1. Adaptive Font Size - adjusts question font based on text length
  2. Image Spacing Fix - removes <br> between consecutive images
  3. Hint System - expandable resource panels with keyboard shortcuts
  
KEYBOARD SHORTCUTS (desktop only):
  - H: Open next closed hint, or close all if all are open
  - Shift+H: Close all hints and scroll to top

GESTURE COMPATIBILITY:
  - Removed e.stopPropagation() that was blocking AnkiDroid swipes
  - Keyboard handler only active on desktop (width > 1100px)
  - focusForHotkeys() skipped on mobile
================================================================================
-->
<script>
(function() {
  // ==========================================================================
  // ADAPTIVE FONT SIZE
  // ==========================================================================
  var question = document.querySelector(".question");
  if (question) {
    var text = question.textContent || question.innerText || "";
    var len = text.replace(/\s+/g, " ").trim().length;
    question.classList.remove("text-short", "text-medium", "text-long");
    if (len < 80) question.classList.add("text-short");
    else if (len < 200) question.classList.add("text-medium");
    else question.classList.add("text-long");
  }

  // ==========================================================================
  // HINT SYSTEM INITIALIZATION
  // ==========================================================================
  var row = document.getElementById("hintRow");
  var area = document.getElementById("hintContentArea");
  if (!row || !area) return;

  // ==========================================================================
  // DETECT MOBILE (for gesture-safe behavior)
  // ==========================================================================
  var isMobile = window.innerWidth <= 1100;

  // ==========================================================================
  // PREVENT LISTENER STACKING
  // Removes old event listeners when card is re-shown (Anki keeps DOM alive)
  // ==========================================================================
  try {
    if (window.__CL_HINTS_KEYDOWN__) {
      document.removeEventListener("keydown", window.__CL_HINTS_KEYDOWN__, true);
      window.__CL_HINTS_KEYDOWN__ = null;
    }
    if (window.__CL_HINTS_ROWCLICK__ && window.__CL_HINTS_ROWCLICK_ROW__ === row) {
      row.removeEventListener("click", window.__CL_HINTS_ROWCLICK__, false);
      window.__CL_HINTS_ROWCLICK__ = null;
      window.__CL_HINTS_ROWCLICK_ROW__ = null;
    }
  } catch(e) {}

  try { document.documentElement.style.scrollBehavior = "auto"; } catch(e) {}

  // ==========================================================================
  // POLYFILLS (for older AnkiDroid versions)
  // ==========================================================================
  if (!Element.prototype.matches) {
    Element.prototype.matches = Element.prototype.msMatchesSelector || Element.prototype.webkitMatchesSelector;
  }
  if (!Element.prototype.closest) {
    Element.prototype.closest = function(s) {
      var el = this;
      while (el && el.nodeType === 1) {
        if (el.matches(s)) return el;
        el = el.parentElement || el.parentNode;
      }
      return null;
    };
  }

  // ==========================================================================
  // UTILITY FUNCTIONS (GESTURE-SAFE)
  // ==========================================================================
  
  function focusForHotkeys() {
    // Skip on mobile to not interfere with gestures
    if (isMobile) return;
    try {
      if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
      document.body.tabIndex = -1;
      document.body.focus();
    } catch(e) {}
  }

  function blockId(f) { return "hintBlock__" + f; }
  function isOpen(f) { return !!document.getElementById(blockId(f)); }

  function scrollToTopOf(el, offset) {
    if (!el) return;
    var off = (typeof offset === "number") ? offset : 12;
    el.scrollIntoView(true);
    window.scrollBy(0, -off);
  }

  // ==========================================================================
  // IMAGE SPACING FIX
  // Removes <br> tags between consecutive images for consistent spacing.
  // Also centers images and fixes parent wrapper margins.
  // ==========================================================================
  function fixImageSpacing(container) {
    if (!container) return;
    var imgs = container.querySelectorAll("img");
    
    for (var i = 0; i < imgs.length; i++) {
      var img = imgs[i];
      img.style.display = "block";
      img.style.marginLeft = "auto";
      img.style.marginRight = "auto";
      img.style.maxWidth = "100%";
      
      // Remove <br> tags immediately before this image if preceded by another image
      var prev = img.previousSibling;
      while (prev) {
        var toCheck = prev;
        prev = prev.previousSibling;
        
        // Skip empty text nodes
        if (toCheck.nodeType === 3 && toCheck.textContent.trim() === "") {
          toCheck.parentNode.removeChild(toCheck);
        } 
        // Check for <br> tags between images
        else if (toCheck.nodeType === 1 && toCheck.tagName === "BR") {
          var beforeBr = toCheck.previousSibling;
          while (beforeBr && beforeBr.nodeType === 3 && beforeBr.textContent.trim() === "") {
            beforeBr = beforeBr.previousSibling;
          }
          // Only remove if there's an image before the <br>
          if (beforeBr && beforeBr.nodeType === 1 && beforeBr.tagName === "IMG") {
            toCheck.parentNode.removeChild(toCheck);
          } else {
            break;
          }
        } else {
          break;
        }
      }
      
      // Fix parent wrapper elements (for hint content with nested divs)
      var parent = img.parentElement;
      while (parent && parent !== container) {
        var tag = parent.tagName;
        if (tag !== "TABLE" && tag !== "TR" && tag !== "TD" && tag !== "TH" &&
            tag !== "UL" && tag !== "OL" && tag !== "LI") {
          parent.style.display = "block";
          parent.style.width = "100%";
          parent.style.textAlign = "center";
          parent.style.margin = "0";
          parent.style.padding = "0";
        }
        parent = parent.parentElement;
      }
    }
  }

  // Fix images in question and extra on load
  var mainContainers = document.querySelectorAll(".question, .extra");
  for (var mc = 0; mc < mainContainers.length; mc++) {
    fixImageSpacing(mainContainers[mc]);
  }

  // ==========================================================================
  // COLLECT CONTENT FROM HIDDEN STORES
  // ==========================================================================
  var templates = {};
  var stores = document.querySelectorAll(".hintStore[data-field]");
  for (var i = 0; i < stores.length; i++) {
    var f = stores[i].getAttribute("data-field");
    templates[f] = stores[i].innerHTML;
  }

  // ==========================================================================
  // ESTABLISH BUTTON ORDER
  // Used to maintain consistent hint panel ordering
  // ==========================================================================
  var pillOrder = [];
  var allPills = row.querySelectorAll(".pill[data-field]");
  for (var j = 0; j < allPills.length; j++) {
    pillOrder.push(allPills[j].getAttribute("data-field"));
  }

  function getInsertPosition(field) {
    var fieldIndex = pillOrder.indexOf(field);
    var existingBlocks = area.querySelectorAll(".hintBlock");
    for (var i = 0; i < existingBlocks.length; i++) {
      var blockField = existingBlocks[i].id.replace("hintBlock__", "");
      var blockIndex = pillOrder.indexOf(blockField);
      if (blockIndex > fieldIndex) return existingBlocks[i];
    }
    return null;
  }

  // ==========================================================================
  // OPEN / CLOSE FUNCTIONS
  // ==========================================================================
  
  function openHint(field, btn) {
    if (isOpen(field)) {
      var existing = document.getElementById(blockId(field));
      if (existing) scrollToTopOf(existing, 12);
      if (btn) btn.classList.add("activeHint");
      return;
    }
    if (!templates.hasOwnProperty(field)) return;

    var block = document.createElement("div");
    block.className = "hintBlock";
    block.id = blockId(field);

    var header = document.createElement("div");
    header.className = "hintHeader";
    header.textContent = (btn ? btn.textContent : field).replace(/[+−]/g, "").trim();

    var body = document.createElement("div");
    body.className = "hintBody";

    var inner = document.createElement("div");
    inner.className = "hintBodyInner";
    inner.innerHTML = templates[field];

    body.appendChild(inner);
    block.appendChild(header);
    block.appendChild(body);

    var insertBefore = getInsertPosition(field);
    if (insertBefore) area.insertBefore(block, insertBefore);
    else area.appendChild(block);

    if (btn) btn.classList.add("activeHint");
    block.classList.add("open");
    
    // Fix image spacing in the newly opened hint
    fixImageSpacing(inner);
    
    requestAnimationFrame(function(){ block.classList.add("animateIn"); });

    setTimeout(function(){
      scrollToTopOf(block, 12);
      focusForHotkeys();
      fixImageSpacing(inner);
    }, 50);
  }

  function closeHint(field, btn) {
    var block = document.getElementById(blockId(field));
    if (!block) {
      if (btn) btn.classList.remove("activeHint");
      return;
    }
    block.classList.remove("animateIn");
    block.classList.add("closing");
    setTimeout(function(){
      if (block.parentNode) block.parentNode.removeChild(block);
    }, 190);
    if (btn) btn.classList.remove("activeHint");
    focusForHotkeys();
  }

  function closeHintInstant(field, btn) {
    var block = document.getElementById(blockId(field));
    if (block && block.parentNode) block.parentNode.removeChild(block);
    if (btn) btn.classList.remove("activeHint");
  }

  function closeAllInstantAndTop() {
    var pills = row.querySelectorAll(".pill[data-field]");
    for (var i = 0; i < pills.length; i++) {
      var field = pills[i].getAttribute("data-field");
      var btn = pills[i].querySelector("a.hint");
      if (field && isOpen(field)) closeHintInstant(field, btn);
    }
    window.scrollTo(0, 0);
    focusForHotkeys();
  }

  function togglePill(pill) {
    var field = pill.getAttribute("data-field");
    if (!field) return;
    var btn = pill.querySelector("a.hint");
    if (isOpen(field)) closeHint(field, btn);
    else openHint(field, btn);
  }

  // ==========================================================================
  // EVENT HANDLERS (GESTURE-SAFE)
  // ==========================================================================
  
  var rowClickHandler = function(e){
    var pill = e.target.closest(".pill");
    if (!pill) return;
    
    // Only preventDefault on the link itself, not stopPropagation
    // This allows AnkiDroid swipe gestures to work
    if (e.target.tagName === "A" || e.target.closest("a")) {
      e.preventDefault();
    }
    // REMOVED: e.stopPropagation() - this was blocking gestures
    
    togglePill(pill);
    focusForHotkeys();
  };
  row.addEventListener("click", rowClickHandler, false);
  window.__CL_HINTS_ROWCLICK__ = rowClickHandler;
  window.__CL_HINTS_ROWCLICK_ROW__ = row;

  // ==========================================================================
  // KEYBOARD HANDLER (desktop only)
  // H = open next closed hint, or close all if all are open
  // Shift+H = close all hints and scroll to top
  // ==========================================================================
  // pillOrder guard: on cards with no resource fields, H used to fall through to scrollTo(0,0)
  if (!isMobile && pillOrder.length > 0) {
    var keyHandler = function(e) {
      var t = e.target;
      if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
      if (t && (t.isContentEditable || t.closest('[contenteditable="true"]'))) return;

      var key = e.key || String.fromCharCode(e.keyCode || e.which);
      if (key !== "h" && key !== "H") return;
      if (e.ctrlKey || e.altKey || e.metaKey) return;

      e.preventDefault();
      e.stopPropagation();

      if (e.shiftKey) {
        closeAllInstantAndTop();
        return;
      }

      var openCount = 0, closedCount = 0;
      for (var i = 0; i < pillOrder.length; i++) {
        if (isOpen(pillOrder[i])) openCount++;
        else closedCount++;
      }

      if (openCount > 0 && closedCount === 0) {
        closeAllInstantAndTop();
        return;
      }

      var nextClosed = null;
      for (var j = 0; j < pillOrder.length; j++) {
        var f = pillOrder[j];
        if (!isOpen(f)) {
          var pillEl = row.querySelector(".pill[data-field='" + f + "']");
          if (pillEl) { nextClosed = pillEl; break; }
        }
      }

      if (nextClosed) togglePill(nextClosed);
      else closeAllInstantAndTop();
    };

    document.addEventListener("keydown", keyHandler, true);
    window.__CL_HINTS_KEYDOWN__ = keyHandler;
    
    setTimeout(focusForHotkeys, 100);
  }
})();
</script>
