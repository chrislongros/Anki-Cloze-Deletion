/* ============================================================================
 * BASE RESET & SETUP
 * ============================================================================ */

html, body { 
  height: auto !important;
  margin: 0;
  padding: 0;
}

body {
  -webkit-text-size-adjust: 100% !important;
  text-size-adjust: 100% !important;
  display: block !important;
}


/* ============================================================================
 * MAIN CARD CONTAINER
 * ============================================================================ */

.card {
  background: #1e1e1e;
  color: #eaeaea;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28px;
  text-align: center;
  padding: 40px 60px;
  box-sizing: border-box;
  min-height: 100vh;

  display: flex !important;
  align-items: flex-start !important;
  justify-content: center !important;
}

.card-wrapper {
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}


/* ============================================================================
 * QUESTION SECTION
 * ============================================================================ */

.question { 
  font-size: 36px !important;
  font-weight: 500;
  line-height: 1.5;
  margin: 0;
  width: 100%;
  text-align: center;
}

.question * { 
  font-size: inherit !important; 
}


/* ============================================================================
 * CLOZE DELETION STYLING
 * ============================================================================ */

.cloze { 
  color: #4caf50;
  font-weight: 700; 
  font-size: inherit !important; 
}


/* ============================================================================
 * DIVIDER
 * ============================================================================ */

.frontBackDivider {
  width: 100%;
  height: 1px;
  margin: 26px auto 18px;
  background: linear-gradient(
    to right, 
    transparent, 
    rgba(255,255,255,0.3) 20%, 
    rgba(255,255,255,0.3) 80%, 
    transparent
  );
  border-radius: 2px;
}


/* ============================================================================
 * EXTRA FIELD (always visible)
 * ============================================================================ */

.extra {
  font-size: 24px !important;
  color: #c88f8f;
  opacity: 0.95;
  margin-bottom: 20px;
  text-align: center;
  width: 100%;
  line-height: 1.7;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.extra * {
  font-size: inherit !important;
}


/* ============================================================================
 * HINT BUTTONS ROW
 * ============================================================================ */

#hintRow {
  margin-top: 10px;
  margin-bottom: 14px;
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  width: 100%;
}

#hintContentArea { 
  margin-top: 14px; 
  width: 100%; 
}

.card-wrapper > template { display: none !important; }
.hintStore { display: none !important; }


/* ============================================================================
 * PILL CONTAINERS
 * ============================================================================ */

.pill { 
  display: inline-flex !important; 
  flex: none !important; 
  width: fit-content !important; 
}


/* ============================================================================
 * HINT BUTTONS
 * ============================================================================ */

a.hint {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 10px 22px !important;
  border-radius: 12px !important;
  line-height: 1.1 !important;
  background: rgba(255,255,255,.06) !important;
  border: 1px solid rgba(255,255,255,.18) !important;
  font-size: 14px !important;
  font-weight: 650 !important;
  letter-spacing: .2px !important;
  text-decoration: none !important;
  white-space: nowrap !important;
  user-select: none !important;
  box-shadow: 0 2px 10px rgba(0,0,0,.18) !important;
  transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

a.hint::after { 
  content: " +" !important; 
  margin-left: 10px !important; 
  font-weight: 900 !important; 
  opacity: .85 !important; 
}

a.hint.activeHint::after { 
  content: " −" !important; 
  opacity: 1 !important; 
}

a.hint.activeHint {
  border-color: rgba(255,255,255,.65) !important;
  box-shadow: 0 0 0 2px rgba(255,255,255,.15) inset, 
              0 4px 18px rgba(0,0,0,.35) !important;
}

/* Hover effect - only on non-touch devices */
@media (hover: hover) {
  a.hint:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 20px rgba(0,0,0,.4) !important;
    background: rgba(255,255,255,.12) !important;
  }
  
  a.hint:active {
    transform: translateY(0) scale(0.98);
  }
}


/* ============================================================================
 * RESOURCE COLOR THEMES
 * ============================================================================ */

.pill.uworld a.hint { color: #5fd38d !important; }
.pill.uworld2ck a.hint { color: #7fe9a8 !important; }
.pill.nejm a.hint { color: #ffd27a !important; }
.pill.amboss a.hint { color: #66aaff !important; }
.pill.fa a.hint { color: #ff9a9a !important; }
.pill.kaplan a.hint { color: #c29bff !important; }
.pill.pathoma a.hint { color: #e0c3a8 !important; }
.pill.utd a.hint { color: #66e0c2 !important; }
.pill.nbme a.hint { color: #cfd8dc !important; }
.pill.notes a.hint { color: #80deea !important; }
.pill.add a.hint { color: #d0d0d0 !important; }

.pill.uworld a.hint.activeHint { background: rgba(95,211,141,.35) !important; }
.pill.uworld2ck a.hint.activeHint { background: rgba(127,233,168,.35) !important; }
.pill.nejm a.hint.activeHint { background: rgba(255,210,122,.30) !important; }
.pill.amboss a.hint.activeHint { background: rgba(102,170,255,.35) !important; }
.pill.fa a.hint.activeHint { background: rgba(255,154,154,.35) !important; }
.pill.kaplan a.hint.activeHint { background: rgba(194,155,255,.35) !important; }
.pill.pathoma a.hint.activeHint { background: rgba(224,195,168,.35) !important; }
.pill.utd a.hint.activeHint { background: rgba(102,224,194,.35) !important; }
.pill.nbme a.hint.activeHint { background: rgba(207,216,220,.35) !important; }
.pill.notes a.hint.activeHint { background: rgba(128,222,234,.35) !important; }
.pill.add a.hint.activeHint { background: rgba(255,255,255,.28) !important; }


/* ============================================================================
 * HINT BLOCKS (Expanded Content)
 * ============================================================================ */

.hintBlock { 
  max-width: 100%; 
  margin: 0 auto 20px; 
}

.hintHeader { 
  font-size: 16px; 
  font-weight: 600; 
  text-align: left; 
  margin-bottom: 10px; 
  opacity: .85; 
  color: #eaeaea;
}

/* Outer container - no animation to prevent layout shifts */
.hintBody {
  border-radius: 12px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
}

/* Inner content - GPU-accelerated animation */
.hintBodyInner {
  padding: 12px 16px;
  text-align: left;
  font-size: 18px;
  line-height: 1.6;
  color: #eaeaea;
  display: flex;
  flex-direction: column;
  align-items: center;

  opacity: 0;
  transform: translateY(-8px);
  transition: opacity 180ms ease, transform 180ms ease;
  will-change: opacity, transform;
}

.hintBlock.animateIn .hintBodyInner {
  opacity: 1;
  transform: translateY(0);
}

.hintBlock.closing .hintBodyInner {
  opacity: 0;
  transform: translateY(-8px);
}

.hintBodyInner * {
  background: none !important;
  box-shadow: none !important;
}


/* ============================================================================
 * LIST STYLING
 * ============================================================================ */

.question ul,
.question ol,
.extra ul,
.extra ol,
.hintBodyInner ul,
.hintBodyInner ol {
  text-align: left !important;
  padding-left: 2em !important;
  margin: 12px 0 !important;
  list-style-position: inside !important;
  display: block !important;
}

.question li,
.extra li,
.hintBodyInner li {
  text-align: left !important;
  padding-left: 0 !important;
  margin: 8px 0 !important;
  display: list-item !important;
}


/* ============================================================================
 * IMAGES
 * ============================================================================ */

.question img,
.extra img,
.hintBodyInner img,
.question br + img {
  display: block !important;
  max-width: 100% !important;
  height: auto !important;
  margin: 8px auto !important;
  border-radius: 10px;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

/* Consecutive images - minimal gap */
.hintBodyInner img + img,
.extra img + img,
.question img + img {
  margin-top: 4px !important;
}

.question br + img {
  margin-top: 12px !important;
}


/* ============================================================================
 * TABLES
 * ============================================================================ */

.hintBodyInner table {
  max-width: 100% !important;
  width: auto !important;
  border-collapse: collapse;
  margin: 12px auto;
  background: rgba(255,255,255,.02);
  border-radius: 8px;
  overflow: hidden;
}

.hintBodyInner td,
.hintBodyInner th {
  padding: 8px 12px;
  vertical-align: top;
  border: 1px solid rgba(255,255,255,.1);
  text-align: left;
}

.hintBodyInner th {
  background: rgba(255,255,255,.05);
  font-weight: 600;
}


/* ============================================================================
 * LINKS
 * ============================================================================ */

.question a,
.extra a,
.hintBodyInner a {
  color: #66aaff;
  text-decoration: underline;
  text-decoration-color: rgba(102, 170, 255, 0.4);
  text-underline-offset: 2px;
}


/* ============================================================================
 * ANKIDROID TEXT WRAPPING FIX
 * ============================================================================ */

.card,
.card-wrapper,
.question,
.question *,
.cloze,
.extra,
.extra *,
.hintBodyInner,
.hintBodyInner * {
  hyphens: none !important;
  -webkit-hyphens: none !important;
  word-break: normal !important;
  white-space: normal !important;
  overflow-wrap: anywhere !important;
}


/* ============================================================================
 * ADAPTIVE FONT SIZE (applied by JavaScript)
 * ============================================================================
 * Short text gets larger fonts for better readability.
 * Thresholds: short (<80 chars), medium (80-200), long (>200)
 */

.question.text-short { font-size: 42px !important; }
.question.text-medium { font-size: 36px !important; }
.question.text-long { font-size: 32px !important; }


/* ============================================================================
 * MOBILE OPTIMIZATION
 * ============================================================================ */

@media (max-width: 1100px) {
  .card { 
    padding: 20px; 
    font-size: 20px; 
    min-height: auto; 
  }
  
  .question { 
    font-size: 22px !important; 
    margin-bottom: 16px; 
  }
  
  /* Adaptive sizes for mobile */
  .question.text-short { font-size: 32px !important; }
  .question.text-medium { font-size: 26px !important; }
  .question.text-long { font-size: 22px !important; }
  
  .extra { 
    font-size: 16px !important; 
    margin-bottom: 16px; 
  }
  
  .frontBackDivider {
    margin: 20px 0 16px;
  }
  
  a.hint { 
    padding: 9px 16px !important; 
    font-size: 13px !important; 
    border-radius: 10px !important; 
  }
  
  #hintRow { 
    gap: 8px; 
  }
  
  .hintBodyInner { 
    font-size: 16px; 
    padding: 10px 12px; 
    line-height: 1.5; 
  }
  
  .question ul,
  .question ol,
  .hintBodyInner ul,
  .hintBodyInner ol {
    padding-left: 1.5em !important;
  }
  
  .question li,
  .hintBodyInner li {
    margin: 6px 0 !important;
  }

  .question img,
  .extra img,
  .hintBodyInner img {
    margin: 4px auto !important;
  }

  .hintBodyInner img + img,
  .extra img + img,
  .question img + img {
    margin-top: 2px !important;
  }
}


/* ============================================================================
 * EDITOR ALIGNMENT OVERRIDES
 * ============================================================================ */

.question [style*="text-align: center"],
.question [style*="text-align:center"],
.extra [style*="text-align: center"],
.extra [style*="text-align:center"] {
  text-align: center !important;
  display: block;
  width: 100%;
}

.question [style*="text-align: left"],
.question [style*="text-align:left"],
.extra [style*="text-align: left"],
.extra [style*="text-align:left"] {
  text-align: left !important;
  display: block;
  width: 100%;
}

.question [style*="text-align: right"],
.question [style*="text-align:right"],
.extra [style*="text-align: right"],
.extra [style*="text-align:right"] {
  text-align: right !important;
  display: block;
  width: 100%;
}
