html, body { 
  height: auto !important;
  margin: 0;
  padding: 0;
}

body {
  -webkit-text-size-adjust: 100% !important;
  text-size-adjust: 100% !important;
}

body, .card {
  display: block !important;
  align-items: initial !important;
  justify-content: initial !important;
}

.card {
  background: #1e1e1e;
  color: #eaeaea;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28px;
  text-align: center;
  padding: 40px 60px;
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  align-items: center;
}

.card-wrapper {
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}

/* ============================================ */
/* QUESTION SECTION */
/* ============================================ */

.question { 
  font-size: 36px;
  font-weight: 500;
  line-height: 1.5;
  margin: 0;
  text-align: left;
  width: 100%;
}

/* ============================================ */
/* IMAGE SPACING FIX (for <br><img> pattern) */
/* ============================================ */

.question br {
  display: block;
  margin-bottom: 20px;
}

.question img,
.question br + img {
  display: block !important;
  margin: 24px auto 12px auto !important;
}

/* ============================================ */
/* DIVIDER */
/* ============================================ */

.frontBackDivider {
  width: 100%;
  height: 1px;
  margin: 26px auto 18px;
  background: linear-gradient(
    to right,
    transparent,
    rgba(255,255,255,0.3) 20%,
    rgba(255,255,255,0.3) 80%,
    transparent
  );
  border-radius: 2px;
}

/* ============================================ */
/* EXTRA FIELD */
/* ============================================ */

.extra {
  font-size: 24px;
  color: #c88f8f;
  opacity: 0.95;
  margin-top: 0;
  margin-bottom: 20px;
  text-align: left;
}

.extra img {
  max-width: 100% !important;
  height: auto !important;
  display: block;
  margin: 8px auto !important;
  border-radius: 10px;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

/* ============================================ */
/* HINT BUTTONS ROW */
/* ============================================ */

#hintRow {
  margin-top: 10px;
  margin-bottom: 14px;
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

#hintContentArea {
  margin-top: 14px;
}

.card-wrapper > template { 
  display: none !important; 
}

/* ============================================ */
/* CLOZE STYLING */
/* ============================================ */

.cloze { 
  color: #4caf50; 
  font-weight: 700;
}

/* ============================================ */
/* IMAGES (GLOBAL) */
/* ============================================ */

.card img {
  max-width: 100% !important;
  height: auto !important;
  display: block;
  margin: 4px auto !important;
  border-radius: 10px;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

.imgFrame {
  border-radius: 10px;
  overflow: hidden;
  margin: 4px auto;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

/* ============================================ */
/* PILLS (Button Containers) */
/* ============================================ */

.pill {
  display: inline-flex !important;
  flex: none !important;
  width: fit-content !important;
}

/* ============================================ */
/* HINT BUTTONS */
/* ============================================ */

a.hint {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 10px 22px !important;
  border-radius: 12px !important;
  line-height: 1.1 !important;
  background: rgba(255,255,255,.06) !important;
  border: 1px solid rgba(255,255,255,.18) !important;
  font-size: 14px !important;
  font-weight: 650 !important;
  letter-spacing: .2px !important;
  text-decoration: none !important;
  white-space: nowrap !important;
  user-select: none !important;
  box-shadow: 0 2px 10px rgba(0,0,0,.18) !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

a.hint:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 8px 20px rgba(0,0,0,.4) !important;
  background: rgba(255,255,255,.12) !important;
}

a.hint:active {
  transform: translateY(0) scale(0.98);
  transition: all 0.1s ease;
}

a.hint::after {
  content: " +" !important;
  margin-left: 10px !important;
  font-weight: 900 !important;
  opacity: .85 !important;
}

a.hint.activeHint::after {
  content: " −" !important;
  opacity: 1 !important;
}

a.hint.activeHint {
  border-color: rgba(255,255,255,.65) !important;
  box-shadow: 0 0 0 2px rgba(255,255,255,.15) inset, 0 4px 18px rgba(0,0,0,.35) !important;
  transform: scale(1.0);
}

/* ============================================ */
/* RESOURCE COLOR THEMES */
/* ============================================ */

.pill.uworld a.hint { color: #5fd38d !important; }
.pill.uworld2ck a.hint { color: #7fe9a8 !important; }
.pill.nejm a.hint { color: #ffd27a !important; }
.pill.amboss a.hint { color: #66aaff !important; }
.pill.fa a.hint { color: #ff9a9a !important; }
.pill.kaplan a.hint { color: #c29bff !important; }
.pill.pathoma a.hint { color: #e0c3a8 !important; }
.pill.utd a.hint { color: #66e0c2 !important; }
.pill.nbme a.hint { color: #cfd8dc !important; }
.pill.add a.hint { color: #d0d0d0 !important; }

.pill.uworld a.hint.activeHint { background: rgba(95,211,141,.35) !important; }
.pill.uworld2ck a.hint.activeHint { background: rgba(127,233,168,.35) !important; }
.pill.nejm a.hint.activeHint { background: rgba(255,210,122,.30) !important; }
.pill.amboss a.hint.activeHint { background: rgba(102,170,255,.35) !important; }
.pill.fa a.hint.activeHint { background: rgba(255,154,154,.35) !important; }
.pill.kaplan a.hint.activeHint { background: rgba(194,155,255,.35) !important; }
.pill.pathoma a.hint.activeHint { background: rgba(224,195,168,.35) !important; }
.pill.utd a.hint.activeHint { background: rgba(102,224,194,.35) !important; }
.pill.nbme a.hint.activeHint { background: rgba(207,216,220,.35) !important; }
.pill.add a.hint.activeHint { background: rgba(255,255,255,.28) !important; }

/* ============================================ */
/* HINT BLOCKS (Expanded Content) */
/* ============================================ */

.hintBlock {
  max-width: 100%;
  margin: 0 auto 20px;
  animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.hintBlock.closing {
  animation: slideOut 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideOut {
  from { opacity: 1; transform: translateY(0) scale(1); }
  to { opacity: 0; transform: translateY(-10px) scale(0.98); }
}

.hintHeader {
  font-size: 16px;
  font-weight: 600;
  text-align: left;
  margin-bottom: 10px;
  opacity: 0.85;
  color: #eaeaea;
}

.hintBody {
  padding: 12px 16px;
  border-radius: 12px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
  text-align: left;
  font-size: 18px;
  line-height: 1.6;
  color: #eaeaea;
}

.hintBody p,
.hintBody div,
.hintBody span,
.hintBody ul,
.hintBody ol,
.hintBody li {
  margin: 0 !important;
  padding: 0 !important;
  background: none !important;
  border: none !important;
  box-shadow: none !important;
}

.hintBody p + p {
  margin-top: 12px !important;
}

.hintBody *:not(img):not(iframe):not(video) {
  background: none !important;
  border: none !important;
  box-shadow: none !important;
  color: inherit !important;
}

.hintBody ul,
.hintBody ol {
  padding-left: 20px !important;
  margin: 8px 0 !important;
}

.hintBody li {
  margin: 4px 0 !important;
}

.hintBody img,
.hintBody video,
.hintBody iframe {
  max-width: 100% !important;
  height: auto !important;
  display: block !important;
  margin: 0 auto !important;
  border-radius: 8px !important;
  box-shadow: 0 4px 12px rgba(0,0,0,.3) !important;
}

/* ============================================ */
/* TABLES */
/* ============================================ */

.hintBody table {
  max-width: 100% !important;
  width: 100% !important;
  border-collapse: collapse;
  margin: 12px 0;
  background: rgba(255,255,255,.02);
  border-radius: 8px;
  overflow: hidden;
}

.hintBody td,
.hintBody th {
  padding: 8px 12px;
  vertical-align: top;
  border: 1px solid rgba(255,255,255,.1);
}

.hintBody th {
  background: rgba(255,255,255,.05);
  font-weight: 600;
}

/* ============================================ */
/* MOBILE OPTIMIZATION */
/* ============================================ */

@media (max-width: 1100px) {
  .card { 
    padding: 20px; 
    font-size: 20px; 
    text-align: left;
    min-height: auto;
    display: block;
  }

  .question { 
    font-size: 26px;
    margin-bottom: 16px;
  }

  .question br {
    margin-bottom: 16px;
  }

  .question img,
  .question br + img {
    margin: 20px auto 10px auto !important;
  }

  .extra { 
    font-size: 18px;
    margin-bottom: 16px;
  }

  .frontBackDivider { 
    margin: 20px 0 16px; 
  }

  a.hint {
    padding: 9px 16px !important;
    font-size: 13px !important;
    border-radius: 10px !important;
  }

  #hintRow { 
    margin-top: 8px;
    margin-bottom: 12px;
    gap: 8px;
  }

  .hintBody {
    font-size: 16px;
    padding: 10px 12px;
    line-height: 1.5;
  }

  .hintBlock {
    margin-bottom: 16px;
  }
}

/* ============================================ */
/* ANKIDROID TEXT WRAPPING FIX */
/* ============================================ */

.card,
.card-wrapper,
.question,
.question *,
.cloze,
.extra,
.extra * {
  hyphens: none !important;
  -webkit-hyphens: none !important;
  word-break: normal !important;
  white-space: normal !important;
  overflow-wrap: anywhere !important;
}
