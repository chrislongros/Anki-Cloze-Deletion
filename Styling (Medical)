/* ============================================ */
/* CLOZE-CHATGPT - STYLING (CSS)               */
/* ============================================ */
/*
  This stylesheet provides:
  - Dark theme styling (#1e1e1e background)
  - Responsive design (desktop + mobile)
  - Colorful hint buttons for medical resources
  - Smooth animations for hint expansion
  - AnkiDroid text wrapping fixes
  
  Color scheme:
  - Background: #1e1e1e (dark gray)
  - Text: #eaeaea (light gray)
  - Cloze answers: #4caf50 (green)
  - Extra field: #c88f8f (muted pink)
*/

/* ============================================ */
/* BASE RESET & SETUP */
/* ============================================ */

html, body { 
  height: auto !important;
  margin: 0;
  padding: 0;
}

/* Prevent mobile browsers from auto-scaling text */
body {
  -webkit-text-size-adjust: 100% !important;
  text-size-adjust: 100% !important;
}

/* Reset flexbox defaults that some Anki versions apply */
body, .card {
  display: block !important;
  align-items: initial !important;
  justify-content: initial !important;
}

/* ============================================ */
/* CARD CONTAINER */
/* ============================================ */

.card {
  background: #1e1e1e;           /* Dark background */
  color: #eaeaea;                /* Light text */
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28px;
  text-align: center;
  padding: 40px;
  box-sizing: border-box;
}

/* Inner wrapper - constrains content width on large screens */
.card-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}

/* ============================================ */
/* QUESTION SECTION */
/* ============================================ */

.question { 
  font-size: 34px;
  font-weight: 500;
  line-height: 1.45;             /* Comfortable line spacing */
  margin: 0;
}

/* ============================================ */
/* DIVIDER */
/* ============================================ */
/* Rainbow gradient line separating question from answer/extras */

.frontBackDivider {
  width: 100%;
  height: 3px;
  margin: 26px auto 18px;
  background: linear-gradient(
    to right,
    transparent,
    #ff6b6b 10%,      /* Red */
    #feca57 25%,      /* Yellow */
    #48dbfb 40%,      /* Cyan */
    #1dd1a1 55%,      /* Green */
    #48dbfb 70%,      /* Cyan */
    #feca57 85%,      /* Yellow */
    transparent
  );
  border-radius: 2px;
}

/* ============================================ */
/* EXTRA FIELD */
/* ============================================ */
/* For additional notes, explanations, mnemonics, etc. */

.extra {
  font-size: 24px;
  color: #c88f8f;                /* Muted pink for distinction */
  opacity: 0.95;
  margin-top: 0;
}

/* Images within the extra field */
.extra img {
  max-width: 100% !important;
  height: auto !important;
  display: block;
  margin: 8px auto !important;
  border-radius: 10px;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

/* ============================================ */
/* HINT BUTTONS ROW */
/* ============================================ */
/* Container for resource buttons (UWorld, AMBOSS, etc.) */

#hintRow {
  margin-top: 0;
  margin-bottom: 14px;
  display: flex;
  gap: 12px;                     /* Space between buttons */
  justify-content: center;
  flex-wrap: wrap;               /* Wrap to next line on small screens */
}

/* ============================================ */
/* HINT CONTENT AREA */
/* ============================================ */
/* Where expanded hint content appears */

#hintContentArea {
  margin-top: 14px;
}

/* Hide template elements (they're just data containers) */
.card-wrapper > template { 
  display: none !important; 
}

/* ============================================ */
/* CLOZE STYLING */
/* ============================================ */

/* Revealed cloze answers - bright green for visibility */
.cloze { 
  color: #4caf50; 
  font-weight: 700;
}

/* Toggle between mobile and desktop cloze display */
.clozefield { 
  display: none;                 /* Hidden by default (desktop) */
}

.editcloze { 
  display: block;                /* Shown by default (desktop) */
}

/* ============================================ */
/* IMAGES */
/* ============================================ */

.card img {
  max-width: 100% !important;
  height: auto !important;
  display: block;
  margin: 4px auto !important;
  border-radius: 10px;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

/* Frame wrapper for images (added by JavaScript) */
.imgFrame {
  border-radius: 10px;
  overflow: hidden;
  margin: 4px auto;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

/* ============================================ */
/* PILLS (Button Containers) */
/* ============================================ */
/* Each .pill wraps a hint button */

.pill {
  display: inline-flex !important;
  flex: none !important;
  width: fit-content !important;
}

/* ============================================ */
/* HINT BUTTONS */
/* ============================================ */
/* Styled buttons for each resource type */

a.hint {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 10px 22px !important;
  border-radius: 12px !important;
  line-height: 1.1 !important;
  background: rgba(255,255,255,.06) !important;   /* Subtle background */
  border: 1px solid rgba(255,255,255,.18) !important;
  font-size: 14px !important;
  font-weight: 650 !important;
  letter-spacing: .2px !important;
  text-decoration: none !important;
  white-space: nowrap !important;
  user-select: none !important;
  box-shadow: 0 2px 10px rgba(0,0,0,.18) !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

/* Hover effect - slight lift */
a.hint:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 8px 20px rgba(0,0,0,.4) !important;
  background: rgba(255,255,255,.12) !important;
}

/* Click effect - press down */
a.hint:active {
  transform: translateY(0) scale(0.98);
  transition: all 0.1s ease;
}

/* Plus icon after button text (indicates expandable) */
a.hint::after {
  content: " +" !important;
  margin-left: 10px !important;
  font-weight: 900 !important;
  opacity: .85 !important;
}

/* Minus icon when expanded */
a.hint.activeHint::after {
  content: " −" !important;
  opacity: 1 !important;
}

/* Active/expanded state styling */
a.hint.activeHint {
  border-color: rgba(255,255,255,.65) !important;
  box-shadow: 0 0 0 2px rgba(255,255,255,.15) inset, 0 4px 18px rgba(0,0,0,.35) !important;
  transform: scale(1.0);
}

/* ============================================ */
/* RESOURCE COLOR THEMES */
/* ============================================ */
/* Each resource type has its own color for easy identification */

.pill.uworld a.hint { color: #5fd38d !important; }      /* Green - UWorld */
.pill.uworld2ck a.hint { color: #7fe9a8 !important; }   /* Light green - UWorld 2CK */
.pill.nejm a.hint { color: #ffd27a !important; }        /* Gold - NEJM */
.pill.amboss a.hint { color: #66aaff !important; }      /* Blue - AMBOSS */
.pill.fa a.hint { color: #ff9a9a !important; }          /* Red/Pink - First Aid */
.pill.kaplan a.hint { color: #c29bff !important; }      /* Purple - Kaplan */
.pill.pathoma a.hint { color: #e0c3a8 !important; }     /* Tan - Pathoma */
.pill.utd a.hint { color: #66e0c2 !important; }         /* Teal - UpToDate */
.pill.nbme a.hint { color: #cfd8dc !important; }        /* Gray - NBME */
.pill.add a.hint { color: #d0d0d0 !important; }         /* Light gray - Additional */

/* Active state backgrounds - tinted version of each color */
.pill.uworld a.hint.activeHint { background: rgba(95,211,141,.35) !important; }
.pill.uworld2ck a.hint.activeHint { background: rgba(127,233,168,.35) !important; }
.pill.nejm a.hint.activeHint { background: rgba(255,210,122,.30) !important; }
.pill.amboss a.hint.activeHint { background: rgba(102,170,255,.35) !important; }
.pill.fa a.hint.activeHint { background: rgba(255,154,154,.35) !important; }
.pill.kaplan a.hint.activeHint { background: rgba(194,155,255,.35) !important; }
.pill.pathoma a.hint.activeHint { background: rgba(224,195,168,.35) !important; }
.pill.utd a.hint.activeHint { background: rgba(102,224,194,.35) !important; }
.pill.nbme a.hint.activeHint { background: rgba(207,216,220,.35) !important; }
.pill.add a.hint.activeHint { background: rgba(255,255,255,.28) !important; }

/* ============================================ */
/* HINT BLOCKS (Expanded Content) */
/* ============================================ */
/* Container for the revealed hint content */

.hintBlock {
  max-width: 980px;
  margin: 0 auto 20px;
  animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Closing animation class (added by JavaScript) */
.hintBlock.closing {
  animation: slideOut 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* Slide in animation */
@keyframes slideIn {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Slide out animation */
@keyframes slideOut {
  from { opacity: 1; transform: translateY(0) scale(1); }
  to { opacity: 0; transform: translateY(-10px) scale(0.98); }
}

/* Hint block header (resource name) */
.hintHeader {
  font-size: 16px;
  font-weight: 600;
  text-align: left;
  margin-bottom: 10px;
  padding: 0;
  background: none;
  border-radius: 0;
  letter-spacing: 0;
  text-transform: none;
  opacity: 0.85;
  color: #eaeaea;
}

/* Hint block body (actual content) */
.hintBody {
  padding: 12px 16px;
  border-radius: 12px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
  text-align: left;
  font-size: 18px;
  line-height: 1.6;
  color: #eaeaea;
}

/* Reset margins/padding for common elements inside hints */
.hintBody p,
.hintBody div,
.hintBody section,
.hintBody article,
.hintBody span,
.hintBody ul,
.hintBody ol,
.hintBody li {
  margin: 0 !important;
  padding: 0 !important;
  background: none !important;
  border: none !important;
  box-shadow: none !important;
}

/* Add spacing between paragraphs */
.hintBody p + p {
  margin-top: 12px !important;
}

/* Reset styles for non-media elements */
.hintBody *:not(img):not(iframe):not(video) {
  background: none !important;
  border: none !important;
  box-shadow: none !important;
  color: inherit !important;
}

/* List styling */
.hintBody ul,
.hintBody ol {
  padding-left: 20px !important;
  margin: 8px 0 !important;
}

.hintBody li {
  margin: 4px 0 !important;
  padding: 0 !important;
}

/* Media elements inside hints */
.hintBody img,
.hintBody svg,
.hintBody video,
.hintBody iframe {
  max-width: 100% !important;
  width: auto !important;
  height: auto !important;
  display: block !important;
  margin: 0 auto !important;
  float: none !important;
  border-radius: 8px !important;
  background: none !important;
  box-shadow: 0 4px 12px rgba(0,0,0,.3) !important;
  padding: 0 !important;
}

/* Spacing between consecutive media/text elements */
.hintBody img + img,
.hintBody img + p,
.hintBody img + div,
.hintBody p + img,
.hintBody div + img {
  margin-top: 4px !important;
}

/* ============================================ */
/* TABLES */
/* ============================================ */

.hintBody table {
  max-width: 100% !important;
  width: 100% !important;
  border-collapse: collapse;
  margin: 12px 0;
  background: rgba(255,255,255,.02);
  border-radius: 8px;
  overflow: hidden;
}

.hintBody td,
.hintBody th {
  padding: 8px 12px;
  vertical-align: top;
  border: 1px solid rgba(255,255,255,.1);
}

.hintBody th {
  background: rgba(255,255,255,.05);
  font-weight: 600;
}

/* ============================================ */
/* MOBILE OPTIMIZATION */
/* ============================================ */
/* Responsive adjustments for screens <= 1100px */

@media (max-width: 1100px) {
  .card { 
    padding: 20px;               /* Less padding on mobile */
    font-size: 20px;             /* Smaller base font */
    text-align: left;            /* Left-align for readability */
  }
  
  .question { 
    font-size: 26px;
    margin-bottom: 16px;
  }
  
  .extra { 
    font-size: 18px; 
  }

  .frontBackDivider { 
    margin: 20px 0 16px; 
  }

  /* Smaller hint buttons on mobile */
  a.hint {
    padding: 9px 16px !important;
    font-size: 13px !important;
    border-radius: 10px !important;
  }

  #hintRow { 
    margin-bottom: 12px;
    gap: 8px;
  }

  .hintBody {
    font-size: 16px;
    padding: 10px 12px;
    line-height: 1.5;
  }
  
  .hintBlock {
    margin-bottom: 16px;
  }

  /* Switch to non-editable cloze on mobile */
  .clozefield { 
    display: block; 
  }
  
  .editcloze { 
    display: none; 
  }
  
  .card img,
  .extra img {
    max-width: 100% !important;
    margin: 3px auto !important;
  }
}

/* ============================================ */
/* ANKIDROID TEXT WRAPPING FIX */
/* ============================================ */
/*
  Fixes for AnkiDroid's WebView which sometimes:
  - Hyphenates words incorrectly (breaking mid-word)
  - Wraps words to new lines unnecessarily
  
  This ensures:
  - No automatic hyphenation
  - Words stay intact unless they're longer than the container
  - Normal text flow with proper wrapping
*/

.card,
.card-wrapper,
.question,
.question *,
.cloze,
.extra,
.extra * {
  hyphens: none !important;
  -webkit-hyphens: none !important;
  -moz-hyphens: none !important;
  -ms-hyphens: none !important;
  word-break: normal !important;
  white-space: normal !important;
  overflow-wrap: anywhere !important;
}
