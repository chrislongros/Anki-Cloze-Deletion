/* 
================================================================================
CLOZE-RESIDENCY — STYLESHEET
================================================================================

PURPOSE:
  Modern, dark-themed card design for medical residency study.
  Optimized for clinical scenarios, imaging, and procedural content.

FEATURES:
  - Dark background (#1e1e1e) - great for reviewing images
  - Tight image spacing for radiology/pathology content
  - Responsive design for desktop and mobile (AnkiDroid)
  - Extra field always visible for clinical pearls
  - AnkiDroid text wrapping fix for medical terminology

DIFFERENCES FROM CLOZE-AI:
  - No hint buttons (use Cloze-AI for UWorld/First Aid hints)
  - Lighter weight CSS
  - Optimized for image-heavy content

CUSTOMIZATION:
  - Colors: Search for "CUSTOMIZE:" comments below
  - Font sizes: In the QUESTION and MOBILE sections
  - Image spacing: In the IMAGES section

AUTHOR: Christos Longros
LICENSE: BSD 3-Clause
LAST UPDATED: January 2026
================================================================================
*/


/* =============================================================================
   BASE RESET & SETUP
   ============================================================================= */

html, body {
  height: auto !important;
  margin: 0;
  padding: 0;
}

body {
  -webkit-text-size-adjust: 100% !important;
  text-size-adjust: 100% !important;
  display: block !important;
}


/* =============================================================================
   MAIN CARD CONTAINER
   =============================================================================
   Dark background is ideal for viewing medical images (CT, MRI, X-ray)
   
   CUSTOMIZE: Change background and text colors here
*/

.card {
  background: #1e1e1e;                 /* CUSTOMIZE: Card background */
  color: #eaeaea;                       /* CUSTOMIZE: Main text color */
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28px;
  text-align: center;
  padding: 40px 60px;
  box-sizing: border-box;
  min-height: 100vh;
  display: flex !important;
  align-items: flex-start !important;
  justify-content: center !important;
}

.card-wrapper {
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}


/* =============================================================================
   QUESTION SECTION
   =============================================================================
   CUSTOMIZE: Change desktop font-size here
*/

.question {
  font-size: 36px !important;          /* CUSTOMIZE: Desktop question size */
  font-weight: 500;
  line-height: 1.5;
  margin: 0;
  width: 100%;
  text-align: center;
  text-align-last: center !important;
  word-spacing: normal !important;
  text-justify: none !important;
}

/* Force consistent font sizes */
.question *, .question span, .question font, .question div, .question p,
.question b, .question i, .question u, .question strong, .question em {
  font-size: inherit !important;
  word-spacing: normal !important;
  text-justify: none !important;
  text-align: inherit !important;
  letter-spacing: normal !important;
}

/* Override justify alignment from imported cards */
.question [style*="justify"], .question [style*="JUSTIFY"],
.extra [style*="justify"], .extra [style*="JUSTIFY"] {
  text-align: left !important;
  word-spacing: normal !important;
  text-justify: none !important;
}

/* Prevent inline-block word gaps */
.question span, .question font, .question b, .question i,
.question strong, .question em, .question u {
  display: inline !important;
  white-space: normal !important;
}


/* =============================================================================
   CLOZE STYLING
   =============================================================================
   CUSTOMIZE: Change cloze answer color here
*/

.cloze {
  color: #4caf50;                      /* CUSTOMIZE: Cloze answer color */
  font-weight: 700;
  font-size: inherit !important;
}

/* Desktop vs Mobile editable cloze */
.clozefield { display: none; }
.editcloze { display: block; }


/* =============================================================================
   LIST STYLING
   =============================================================================
   Great for differential diagnoses, treatment steps, etc.
*/

.question ul, .question ol {
  text-align: left !important;
  text-align-last: left !important;
  padding-left: 1.5em !important;
  margin: 12px 0 !important;
  list-style-position: outside !important;
  display: block !important;
  width: 100% !important;
  max-width: none !important;
}

.question li {
  text-align: left !important;
  text-align-last: left !important;
  padding-left: 0.5em !important;
  margin: 8px 0 !important;
  display: list-item !important;
}

/* Extra field lists */
.extra ul, .extra ol {
  text-align: left !important;
  text-align-last: left !important;
  padding-left: 1.5em !important;
  margin: 12px 0 !important;
  list-style-position: outside !important;
  display: block !important;
  width: 100% !important;
  align-self: flex-start !important;
}

.extra li {
  text-align: left !important;
  text-align-last: left !important;
  padding-left: 0.5em !important;
  margin: 8px 0 !important;
  display: list-item !important;
}


/* =============================================================================
   DIVIDER
   ============================================================================= */

.frontBackDivider {
  width: 100%;
  height: 1px;
  margin: 26px auto 18px;
  background: linear-gradient(
    to right,
    transparent,
    rgba(255,255,255,0.3) 20%,
    rgba(255,255,255,0.3) 80%,
    transparent
  );
  border-radius: 2px;
}


/* =============================================================================
   EXTRA FIELD
   =============================================================================
   Perfect for clinical pearls, differentials, and explanations.
   
   CUSTOMIZE: Change Extra field color here
*/

.extra {
  font-size: 24px !important;          /* CUSTOMIZE: Extra field size */
  color: #c88f8f;                      /* CUSTOMIZE: Extra field color */
  opacity: 0.95;
  margin-top: 0;
  margin-bottom: 20px;
  text-align: center;
  text-align-last: center !important;
  word-spacing: normal !important;
  text-justify: none !important;
  width: 100%;
  line-height: 1.7;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.extra, .extra *, .extra span, .extra font, .extra div, .extra p,
.extra b, .extra i, .extra u, .extra strong, .extra em {
  font-size: inherit !important;
  word-spacing: normal !important;
  text-justify: none !important;
}

.extra > *, .extra div, .extra table, .extra p {
  margin-left: auto !important;
  margin-right: auto !important;
  max-width: 100% !important;
}


/* =============================================================================
   IMAGES
   =============================================================================
   Tight spacing for consecutive images (CT series, comparison views, etc.)
   
   CUSTOMIZE: Image margins and border-radius here
*/

.question img, .extra img, .question br + img {
  display: block !important;
  max-width: 100% !important;
  height: auto !important;
  margin: 8px auto !important;         /* CUSTOMIZE: Image spacing */
  border-radius: 10px;                 /* CUSTOMIZE: Image corners */
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

/* Consecutive images - minimal gap for series viewing */
.question img + img, .extra img + img {
  margin-top: 4px !important;          /* CUSTOMIZE: Gap between images */
}


/* =============================================================================
   MOBILE OPTIMIZATION (AnkiDroid)
   =============================================================================
   CUSTOMIZE: Mobile font sizes in the .text-short/medium/long classes
*/

@media (max-width: 1100px) {
  .card {
    padding: 20px;
    font-size: 20px;
    min-height: auto;
    display: flex !important;
    align-items: flex-start !important;
    justify-content: center !important;
  }

  .question {
    font-size: 22px !important;
    margin-bottom: 16px;
    line-height: 1.6;
  }

  /* Adaptive font sizes for mobile */
  .question.text-short { font-size: 32px !important; }   /* < 80 chars */
  .question.text-medium { font-size: 26px !important; }  /* 80-200 chars */
  .question.text-long { font-size: 22px !important; }    /* > 200 chars */

  /* Mobile list styling */
  .question ul, .question ol, .extra ul, .extra ol {
    padding-left: 1.5em !important;
    list-style-position: outside !important;
    text-align: left !important;
    text-align-last: left !important;
    width: 100% !important;
    max-width: none !important;
    margin: 8px 0 !important;
  }
  
  .question li, .extra li {
    margin: 6px 0 !important;
    text-align: left !important;
    text-align-last: left !important;
    padding-left: 0.3em !important;
  }

  .extra {
    font-size: 16px !important;
    margin-bottom: 16px;
    line-height: 1.65;
  }

  .frontBackDivider { 
    margin: 20px 0 16px; 
  }

  /* Mobile: show non-editable for better performance */
  .clozefield { display: block; }
  .editcloze { display: none; }

  /* Tighter image spacing on mobile */
  .question img, .extra img, .question br + img {
    margin: 4px auto !important;
  }

  .question img + img, .extra img + img {
    margin-top: 2px !important;
  }
}


/* =============================================================================
   ANKIDROID TEXT WRAPPING FIX
   =============================================================================
   Prevents long medical terms from being cut off.
*/

.card, .card-wrapper, .question, .question *, .cloze, .extra, .extra * {
  hyphens: none !important;
  -webkit-hyphens: none !important;
  word-break: normal !important;
  white-space: normal !important;
  overflow-wrap: anywhere !important;
}


/* =============================================================================
   EDITOR ALIGNMENT OVERRIDES
   ============================================================================= */

.question [style*="text-align: center"], .question [style*="text-align:center"],
.extra [style*="text-align: center"], .extra [style*="text-align:center"] {
  text-align: center !important;
  word-spacing: normal !important;
  display: block;
  width: 100%;
}

.question [style*="text-align: left"], .question [style*="text-align:left"],
.extra [style*="text-align: left"], .extra [style*="text-align:left"] {
  text-align: left !important;
  word-spacing: normal !important;
  display: block;
  width: 100%;
}

.question [style*="text-align: right"], .question [style*="text-align:right"],
.extra [style*="text-align: right"], .extra [style*="text-align:right"] {
  text-align: right !important;
  word-spacing: normal !important;
  display: block;
  width: 100%;
}

/* Force override justify alignment */
.question [style*="text-align: justify"], .question [style*="text-align:justify"],
.extra [style*="text-align: justify"], .extra [style*="text-align:justify"] {
  text-align: left !important;
  word-spacing: normal !important;
  text-justify: none !important;
  display: block;
  width: 100%;
}
