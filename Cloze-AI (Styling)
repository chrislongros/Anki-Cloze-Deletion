/*
================================================================================
CLOZE-AI — STYLESHEET (FINAL)
================================================================================
- Line breaks work (divs are display:block)
- Consistent font rendering
- Tighter image spacing
- AnkiDroid compatible
================================================================================
*/

/* Base Reset */
html, body { 
  height: auto !important;
  margin: 0;
  padding: 0;
}

body {
  -webkit-text-size-adjust: 100% !important;
  text-size-adjust: 100% !important;
}

/* Main Card Container */
.card {
  background: #1e1e1e;
  color: #eaeaea;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28px;
  text-align: center;
  padding: 40px 60px;
  box-sizing: border-box;
}

.card-wrapper {
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
}

/* Question Section */
.question { 
  font-size: 36px;
  font-weight: 500;
  line-height: 1.5;
  margin: 0;
  width: 100%;
  text-align: center;
}

/* DIVs create line breaks - this is essential! */
.question div, .extra div, .hintBodyInner div {
  display: block;
  width: 100%;
}

/* Cloze Styling */
.cloze { 
  color: #4caf50;
  font-weight: 700; 
  font-size: inherit !important; 
}

/* Divider */
.frontBackDivider {
  width: 100%;
  height: 1px;
  margin: 26px auto 18px;
  background: linear-gradient(
    to right, 
    transparent, 
    rgba(255,255,255,0.3) 20%, 
    rgba(255,255,255,0.3) 80%, 
    transparent
  );
}

/* Extra Field */
.extra {
  font-size: 24px !important;
  color: #c88f8f;
  opacity: 0.95;
  margin-bottom: 20px;
  text-align: center;
  width: 100%;
  line-height: 1.7;
}

/* Hint Buttons Row */
#hintRow {
  margin-top: 16px;
  margin-bottom: 14px;
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  width: 100%;
}

#hintContentArea { 
  margin-top: 14px; 
  width: 100%; 
}

.hintStore { display: none !important; }

/* Pill Containers */
.pill { 
  display: inline-flex !important; 
}

/* Hint Buttons */
a.hint {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 10px 22px !important;
  border-radius: 12px !important;
  line-height: 1.1 !important;
  background: rgba(255,255,255,.06) !important;
  border: 1px solid rgba(255,255,255,.18) !important;
  font-size: 14px !important;
  font-weight: 650 !important;
  letter-spacing: .2px !important;
  text-decoration: none !important;
  white-space: nowrap !important;
  user-select: none !important;
  box-shadow: 0 2px 10px rgba(0,0,0,.18) !important;
  cursor: pointer;
}

a.hint::after { 
  content: " +" !important; 
  margin-left: 10px !important; 
  font-weight: 900 !important; 
  opacity: .85 !important; 
}

a.hint.activeHint::after { 
  content: " −" !important; 
  opacity: 1 !important; 
}

a.hint.activeHint {
  border-color: rgba(255,255,255,.65) !important;
  box-shadow: 0 0 0 2px rgba(255,255,255,.15) inset, 
              0 4px 18px rgba(0,0,0,.35) !important;
}

/* Resource Colors */
.pill.notes a.hint { color: #80deea !important; }
.pill.uworld a.hint { color: #5fd38d !important; }
.pill.uworld2ck a.hint { color: #7fe9a8 !important; }
.pill.amboss a.hint { color: #66aaff !important; }
.pill.missed a.hint { color: #ff8a65 !important; }
.pill.kaplan a.hint { color: #c29bff !important; }
.pill.pathoma a.hint { color: #e0c3a8 !important; }
.pill.bnb a.hint { color: #ffcc80 !important; }
.pill.fa a.hint { color: #ff9a9a !important; }
.pill.nbme a.hint { color: #cfd8dc !important; }
.pill.nejm a.hint { color: #ffd27a !important; }
.pill.utd a.hint { color: #66e0c2 !important; }
.pill.add a.hint { color: #d0d0d0 !important; }

/* Active Colors */
.pill.notes a.hint.activeHint { background: rgba(128,222,234,.35) !important; }
.pill.uworld a.hint.activeHint { background: rgba(95,211,141,.35) !important; }
.pill.uworld2ck a.hint.activeHint { background: rgba(127,233,168,.35) !important; }
.pill.amboss a.hint.activeHint { background: rgba(102,170,255,.35) !important; }
.pill.missed a.hint.activeHint { background: rgba(255,138,101,.35) !important; }
.pill.kaplan a.hint.activeHint { background: rgba(194,155,255,.35) !important; }
.pill.pathoma a.hint.activeHint { background: rgba(224,195,168,.35) !important; }
.pill.bnb a.hint.activeHint { background: rgba(255,204,128,.35) !important; }
.pill.fa a.hint.activeHint { background: rgba(255,154,154,.35) !important; }
.pill.nbme a.hint.activeHint { background: rgba(207,216,220,.35) !important; }
.pill.nejm a.hint.activeHint { background: rgba(255,210,122,.30) !important; }
.pill.utd a.hint.activeHint { background: rgba(102,224,194,.35) !important; }
.pill.add a.hint.activeHint { background: rgba(255,255,255,.28) !important; }

/* Hint Blocks */
.hintBlock { 
  max-width: 100%; 
  margin: 0 auto 20px; 
}

.hintHeader { 
  font-size: 16px; 
  font-weight: 600; 
  text-align: center; 
  margin-bottom: 10px; 
  opacity: .85; 
  color: #eaeaea;
}

.hintBody {
  border-radius: 12px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
}

.hintBodyInner {
  padding: 12px 16px;
  text-align: center;
  font-size: 18px;
  line-height: 1.6;
  color: #eaeaea;
}

.hintBodyInner * { 
  background: none !important; 
  box-shadow: none !important; 
}

/* List Styling */
.question ul, .question ol, 
.extra ul, .extra ol, 
.hintBodyInner ul, .hintBodyInner ol {
  text-align: left !important;
  padding-left: 1.5em !important;
  margin: 12px 0 !important;
  list-style-position: outside !important;
}

.question li, .extra li, .hintBodyInner li {
  text-align: left !important;
  padding-left: 0.5em !important;
  margin: 8px 0 !important;
}

/* Images - Tight Spacing */
.question img, .extra img, .hintBodyInner img {
  display: block !important;
  max-width: 100% !important;
  height: auto !important;
  margin: 4px auto !important;
  border-radius: 10px;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}

.question img + img, .extra img + img, .hintBodyInner img + img {
  margin-top: 2px !important;
}

/* Tables */
.hintBodyInner table, .extra table, .question table {
  max-width: 100% !important;
  border-collapse: collapse;
  margin: 12px auto;
  background: rgba(255,255,255,.02);
  border-radius: 8px;
}

.hintBodyInner td, .hintBodyInner th,
.extra td, .extra th,
.question td, .question th {
  padding: 8px 12px;
  border: 1px solid rgba(255,255,255,.1);
  text-align: left;
}

/* Links */
.question a, .extra a, .hintBodyInner a {
  color: #66aaff;
  text-decoration: underline;
  word-break: break-all !important;
  overflow-wrap: anywhere !important;
}

/* Text Wrapping */
.card, .card-wrapper, .question, .question *, .cloze, 
.extra, .extra *, .hintBodyInner, .hintBodyInner * {
  word-break: normal !important;
  white-space: normal !important;
  overflow-wrap: anywhere !important;
}

/* Mobile */
@media (max-width: 1100px) {
  .card { 
    padding: 20px; 
    font-size: 20px; 
  }
  
  .question { 
    font-size: 22px !important; 
    margin-bottom: 16px; 
  }
  
  /* Adaptive font sizes based on text length (set by JavaScript) */
  .question.text-short { font-size: 32px !important; }
  .question.text-medium { font-size: 26px !important; }
  .question.text-long { font-size: 22px !important; }
  
  .extra { 
    font-size: 20px !important;
    margin-bottom: 16px; 
  }
  
  .frontBackDivider { 
    margin: 20px 0 16px; 
  }
  
  a.hint { 
    padding: 9px 16px !important; 
    font-size: 13px !important; 
    border-radius: 10px !important; 
  }
  
  #hintRow { 
    gap: 8px; 
  }
  
  .hintBodyInner { 
    font-size: 18px;
    padding: 10px 12px; 
    line-height: 1.5; 
  }
  
  .question ul, .question ol, .extra ul, .extra ol, .hintBodyInner ul, .hintBodyInner ol {
    padding-left: 1.2em !important;
    margin: 8px 0 !important;
  }
  
  .question li, .extra li, .hintBodyInner li {
    margin: 6px 0 !important;
    padding-left: 0.3em !important;
  }

  .question img, .extra img, .hintBodyInner img { 
    margin: 4px auto !important; 
  }
  
  .question img + img, .extra img + img, .hintBodyInner img + img { 
    margin-top: 2px !important; 
  }
}
