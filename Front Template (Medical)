<div class="card-wrapper">
  <div class="question">
    {{cloze:Text}}
  </div>
</div>

<script>
(function() {
  var question = document.querySelector(".question");
  if (!question) return;
  var text = question.textContent || question.innerText || "";
  var len = text.replace(/\s+/g, " ").trim().length;
  question.classList.remove("text-short", "text-medium", "text-long");
  if (len < 80) question.classList.add("text-short");
  else if (len < 200) question.classList.add("text-medium");
  else question.classList.add("text-long");
})();
</script>
